# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# publishable key (sb_publishable_…): safe in the browser, read-only thanks to RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key (sb_secret_…): server only, needed from step 3 for every write
SUPABASE_SECRET_KEY=

# Token mint (step 4)
NEXT_PUBLIC_TOKEN_MINT=
