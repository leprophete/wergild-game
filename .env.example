# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# publishable key (sb_publishable_…): safe in the browser, read-only thanks to RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret key (sb_secret_…): server only, needed from step 3 for every write
SUPABASE_SECRET_KEY=

# Domain(s) players sign in on, comma-separated (required in production), e.g. wergild.game,www.wergild.game
APP_DOMAIN=

# Session cookie signing secret (server only): node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Solana RPC used by the wallet adapter (defaults to devnet)
NEXT_PUBLIC_SOLANA_RPC=

# Token mint (step 4) — devnet test token until launch, then the pump.fun mint
NEXT_PUBLIC_TOKEN_MINT=

# Helius (step 4) — https://dashboard.helius.dev → API Keys. Used for RPC reads and webhooks.
HELIUS_API_KEY=
# Optional: any Solana RPC URL; overrides the Helius one
SOLANA_RPC_URL=
# Secret Helius sends in the Authorization header of webhook calls (you choose it)
HELIUS_WEBHOOK_SECRET=
# Protects /api/cron/reconcile (called every 10 minutes)
CRON_SECRET=

# Wallet(s) allowed on /admin, comma-separated (server only)
ADMIN_WALLETS=

# Developer wallet shown on /rules (rule 10), set at launch
NEXT_PUBLIC_DEV_WALLET=
